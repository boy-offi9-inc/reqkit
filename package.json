{
  "name": "@boy-offi9-inc/reqkit",
  "version": "0.8.0",
  "description": "Small, composable HTTP helpers \u2014 retry with backoff and Retry-After, timeouts, normalized errors, rate limiter, circuit breaker, response cache, resumable downloads, SSE/NDJSON streams, mock fetch, and an opt-in createFetch. Not a client; works alongside fetch/axios/anything.",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./browser": {
      "types": "./types/index.d.mts",
      "default": "./dist/reqkit.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-esm.js",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node smoke/run.mjs",
    "check": "npm run build && npm test && npm run typecheck && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "http",
    "fetch",
    "retry",
    "backoff",
    "timeout",
    "rate-limit",
    "retry-after",
    "download-progress",
    "error-normalization",
    "utility",
    "limiter",
    "concurrency",
    "dedupe",
    "http-client",
    "fetch-wrapper",
    "abort-signal",
    "circuit-breaker",
    "cache",
    "sse",
    "ndjson",
    "streaming",
    "resumable-download",
    "mock",
    "browser",
    "deno",
    "bun",
    "cloudflare-workers",
    "esm",
    "pagination",
    "auth",
    "token-refresh",
    "link-header",
    "stale-if-error",
    "observability",
    "logging"
  ],
  "author": "Boy Offi9",
  "license": "MIT",
  "homepage": "https://github.com/boy-offi9-inc/reqkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boy-offi9-inc/reqkit.git"
  },
  "bugs": {
    "url": "https://github.com/boy-offi9-inc/reqkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "types",
    "dist",
    "docs/recipes.md",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
